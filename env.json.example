{
  "name": "analysis",
  "oss": {
    "provider": "ossutil",
    "binary": "ossutil",
    "endpoint": "oss-cn-hongkong.aliyuncs.com",
    "bucket": "dream-ana",
    "prefix": "snapshot/",
    "configFile": ""
  },
  "sync": {
    "intervalMinutes": 60,
    "minAgeSeconds": 60,
    "countIncludesHeader": false,
    "concurrency": 1
  },
  "process": {
    "nice": 10
  },
  "runtime": {
    "dataDir": "data",
    "stateDir": "runtime",
    "logDir": "logs"
  },
  "report": {
    "inlineMaxChars": 3500,
    "signTtlHours": 24
  },
  "bot": {
    "type": "dingtalk",
    "appId": "",
    "appSecret": "",
    "allowedStaffIds": [],
    "allowedConversationIds": [],
    "adminStaffIds": [],
    "notify": {
      "warn": ""
    }
  }
}
